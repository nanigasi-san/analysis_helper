/**
 * 他の人のメモを取得する
 */
function getOtherMemo() {
	$.ajax({
		url: "runner.jsp",
		data: { "json" : "otherMemo"
				, "event" : eventNumber
				, "file" : fileIndex
				, "runner" : runnerId
				, "memoUser" : $('#selOtherMemo').val() },
		type: "POST",
		dataType: "json"
	}).done( function ( aData, aTextStatus, aJqXHR ) {
		if (aData != null && aData.returnExists == "true") {
			$('.row-leg-memo').css('display', 'table-row');
			$('.row-leg-memo-margin').css('display', 'table-row');
			$('.btn-leg-memo').css('visibility', 'visible');	// メモ登録用ボタンはメモ入力・表示中のみ表示
			$('.block-show-memo-view').css('display', 'block');
			$('.row-leg-comment').css('display', 'none');		// コメント行は初期は非表示

			// 戻り値をotherMemoListに格納
			var retMemoList = aData.returnValue.memoList;
			otherMemoList = {};
			for (var i = 0; i < memoListKeyList.length; i++) {
				var memoListKey = memoListKeyList[i];
				var retItem = retMemoList[memoListKey];
				var memoItem = new Object();
				memoItem.memoExists = retItem["memoExists"];
				memoItem.memo = retItem["memo"];
				var commentList = [];
				memoItem.commentExists = retItem["commentExists"];
				if (memoItem.commentExists == true) {
					var retCommentList = retItem["commentList"];
					for (var j = 0; j < retCommentList.length; j++) {
						var retCommentItem = retCommentList[j];
						var commentItem = new Object();
						commentItem.index = retCommentItem["index"];
						commentItem.userCode = retCommentItem["userCode"];
						commentItem.userName = retCommentItem["userName"];
						commentItem.comment = retCommentItem["comment"];
						commentList.push(commentItem);
					}
					
				}
				memoItem.commentList = commentList;
				otherMemoList[memoListKey] = memoItem;
			}

			for (var i = 0; i < memoListKeyList.length; i++) {
				var memoListKey = memoListKeyList[i];
				// レッグメモ保存ボタンをコメントマークにする
				var spanLegMemoSaveElement = $("#btnMemo" + String(memoListKey) + " span");
				if (spanLegMemoSaveElement.hasClass("glyphicon-ok")) { 
					spanLegMemoSaveElement.addClass("glyphicon-comment").removeClass("glyphicon-ok");
				}

				// メモをセットする
				var memoItem = otherMemoList[memoListKey];
				var txtMemoElement = $("#txtMemo" + String(memoListKey));
				if (memoItem.memoExists) {
					txtMemoElement.val(memoItem.memo);
				} else {
					txtMemoElement.val("");
				}
				txtMemoElement.attr('readonly', true);
		
				// コメントがある場合は着色
				var btnLegMemoSaveElement = $("#btnMemo" + String(memoListKey));
				if (memoItem.commentExists == true) {
					if (btnLegMemoSaveElement.hasClass("btn-comment-on") == false) {
						btnLegMemoSaveElement.addClass("btn-comment-on");
					}
					if (btnLegMemoSaveElement.hasClass("btn-comment-off")) {
						btnLegMemoSaveElement.removeClass("btn-comment-off");
					}
				}
				else {
					if (btnLegMemoSaveElement.hasClass("btn-comment-off") == false) {
						btnLegMemoSaveElement.addClass("btn-comment-off");
					}
					if (btnLegMemoSaveElement.hasClass("btn-comment-on")) {
						btnLegMemoSaveElement.removeClass("btn-comment-on");
					}
				}
			}

		}
	}).fail( function ( aJqXHR, aTextStatus, aErrorThrown ) {
	});
}

/**
 * コメント行を追加
 */
function addCommentRow(aTemplateRowElement, aMemoListKey, aCommentItem) {

	var newCommentRow = aTemplateRowElement.clone(false);
	var commentEditButton = newCommentRow.children('td').eq(1).children('button').eq(0);
	commentEditButton.attr('id', 'btnCommentEdit' + String(aMemoListKey) + "_" + String(aCommentItem.index));

	if (aCommentItem.userCode == myUserCode) {

		commentEditButton.css('visibility', 'visible');
		commentEditButton.click( function() {
			var commentKey = this.id.substring(14);
			var sepPos = commentKey.indexOf("_");
			var memoListKey = Number( commentKey.substring(0, sepPos) );
			var commentIndex = Number( commentKey.substring(sepPos + 1) );
			var memoItem = $("#btnShowMemo").hasClass("btn-primary") ? myMemoList[memoListKey] : otherMemoList[memoListKey];
			var commentItem = null;
			for (var i = 0; i < memoItem.commentList.length; i++) {
				if (memoItem.commentList[i].index == commentIndex) {
					commentItem = memoItem.commentList[i];
					break;
				}
			}
			if (commentItem != null) {
				$('#txtEditComment').val(commentItem.comment).attr('data-lc-memo-list-key', memoListKey).attr('data-lc-comment-index', commentIndex);
				$('#chkDeleteComment').prop("checked", false);
				$('#divModalEditComment').modal();
			}
		});
	}

	var cellElement = newCommentRow.children('td').eq(0);
	cellElement.find('span').eq(0).text(aCommentItem.userName);
	cellElement.find('span').eq(1).text(aCommentItem.comment);

	newCommentRow.css('display', 'table-row');
	newCommentRow.insertBefore(aTemplateRowElement);

}
